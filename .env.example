# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# "Publishable" key (sb_publishable_...) — or the legacy "anon" key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# "Secret" key (sb_secret_...) — or the legacy "service_role" key. Server-only, never share.
SUPABASE_SECRET_KEY=

# Optional: WhatsApp number (with country code) behind "Contact us" / Help buttons, e.g. 919876543210
NEXT_PUBLIC_SUPPORT_WHATSAPP=

# Public address of the site, used in password-reset emails, e.g. https://socialgrid-wheat.vercel.app
NEXT_PUBLIC_SITE_URL=

# Emergency password reset page (/reset) — any secret phrase, 12+ characters
RECOVERY_CODE=

# --- Razorpay (optional; clients get a "Pay" button when set) ---
# Dashboard → Account & Settings → API Keys. Use rzp_test_ keys until you go live.
RAZORPAY_KEY_ID=
# Server-only, never share
RAZORPAY_KEY_SECRET=
# Same value as RAZORPAY_KEY_ID; read in the browser to open the checkout
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# --- AI (optional; the AI buttons only appear when a key is set) ---
# Text: River (DeepSeek) first, OpenRouter as fallback
RIVER_API_KEY=
# RIVER_BASE_URL=https://api.river.ai/v1
# RIVER_MODEL=deepseek-ai/DeepSeek-V4.1-Flash
OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_TEXT_MODEL=deepseek/deepseek-chat
# Images are generated through OpenRouter
# OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image

# Used only by `npm run seed` (leave blank to auto-generate passwords)
SEED_EXPERT1_EMAIL=
SEED_EXPERT1_NAME=
SEED_EXPERT1_PASSWORD=
SEED_EXPERT2_EMAIL=
SEED_EXPERT2_NAME=
SEED_EXPERT2_PASSWORD=

# --- Analytics & SEO (optional) ---
# Microsoft Clarity: clarity.microsoft.com → your project → Settings → Overview → Project ID
CLARITY_PROJECT_ID=
# Google Search Console: "HTML tag" method → only the content="..." value
GOOGLE_SITE_VERIFICATION=
# Public address used in the sitemap (defaults to https://socialgrid.dev)
# NEXT_PUBLIC_SITE_URL=https://socialgrid.dev

# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# "Publishable" key (sb_publishable_...) — or the legacy "anon" key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# "Secret" key (sb_secret_...) — or the legacy "service_role" key. Server-only, never share.
SUPABASE_SECRET_KEY=

# Optional: WhatsApp number (with country code) behind "Contact us" / Help buttons, e.g. 919876543210
NEXT_PUBLIC_SUPPORT_WHATSAPP=

# Optional: internal domain for phone-number logins. Never receives email. Don't change after launch.
# NEXT_PUBLIC_CLIENT_EMAIL_DOMAIN=clients.socialgrid.app

# Used only by `npm run seed` (leave blank to auto-generate passwords)
SEED_EXPERT1_EMAIL=
SEED_EXPERT1_NAME=
SEED_EXPERT1_PASSWORD=
SEED_EXPERT2_EMAIL=
SEED_EXPERT2_NAME=
SEED_EXPERT2_PASSWORD=
